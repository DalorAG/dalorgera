{
  "expo": {
    "name": "Dalor Gawa",
    "slug": "garantie-radar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "garantieradar",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dalor.gewaga",
      "buildNumber": "1",
      "appleTeamId": "JU7XHAGP62",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dalor.garantieradar",
      "versionCode": 2,
      "permissions": [],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4B4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dalor Gawa nutzt die Kamera, um Kassenbons und Garantiescheine zu fotografieren.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dalor Gawa greift auf deine Fotos zu, damit du Belege aus der Galerie hinzufügen kannst.",
          "cameraPermission": "Dalor Gawa nutzt die Kamera, um Kassenbons und Garantiescheine zu fotografieren.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "de",
              "en",
              "ru"
            ],
            "android": [
              "de",
              "en",
              "ru"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6ebff56-281a-4799-b820-4c8c34479e12"
      }
    },
    "owner": "dalorteam",
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json",
      "ru": "./locales/ru.json"
    }
  }
}
