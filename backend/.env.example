PORT=3000

# Supabase project "dalorgewa"
SUPABASE_URL=https://lunokowximvnzefgfnib.supabase.co
# Dashboard → Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key, only needed for the reminders worker. Never commit it, never ship it to the app.
SUPABASE_SECRET_KEY=

REMINDERS_WORKER_ENABLED=true
# Optional, only if "enhanced push security" is enabled in Expo
EXPO_ACCESS_TOKEN=
# Receipt / warranty card recognition. Without a key the recognize endpoint returns 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Garantieverlängerung requests are emailed to our team via Resend. Without a key they are only stored.
RESEND_API_KEY=
RESEND_FROM="Garantie Wallet <noreply@example.com>"
WARRANTY_REQUESTS_EMAIL_TO=
CORS_ORIGINS=*
